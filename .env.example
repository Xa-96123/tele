# Optional. Same phone number as the Telegram app on your Mac.
# Open https://my.telegram.org/apps — reuse an existing app if you already have one.
# If creating an app fails (ERROR / blank page), skip this and use Desktop export instead.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Node/next dev does not use the system VPN/proxy automatically.
# Point it at your local Clash / V2Ray HTTP port if t.me preview fails:
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
TELEGRAM_PROXY=
